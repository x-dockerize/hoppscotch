HOPPSCOTCH_VERSION=2026.1.1
HOPPSCOTCH_SERVER_HOSTNAME=hoppscotch.example.com

#-----------------------Backend Config------------------------------#
# DATABASE
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=hoppscotch
DATABASE_USER=hoppscotch
DATABASE_PASSWORD=

# Sensitive Data Encryption Key while storing in Database (32 character)
# Generate with: openssl rand -hex 16
DATA_ENCRYPTION_KEY=

# Whitelisted origins for the Hoppscotch App.
# This list controls which origins can interact with the app through cross-origin comms.
# - https://{hostname}: Web app origin
# - HOPPSCOTCH_DESKTOP_ORIGIN: Desktop app origin (Tauri). Derived from hostname by
#   replacing dots with underscores and prefixing with "http://app."
#   Example: hoppscotch.example.com → http://app.hoppscotch_example_com
HOPPSCOTCH_DESKTOP_ORIGIN=http://app.hoppscotch_example_com
WHITELISTED_ORIGINS=https://${HOPPSCOTCH_SERVER_HOSTNAME},${HOPPSCOTCH_DESKTOP_ORIGIN}

#-----------------------Frontend Config------------------------------#
# Base URLs
VITE_BASE_URL=https://${HOPPSCOTCH_SERVER_HOSTNAME}
VITE_SHORTCODE_BASE_URL=https://${HOPPSCOTCH_SERVER_HOSTNAME}
VITE_ADMIN_URL=https://${HOPPSCOTCH_SERVER_HOSTNAME}/admin

# Backend URLs
VITE_BACKEND_GQL_URL=https://${HOPPSCOTCH_SERVER_HOSTNAME}/graphql
VITE_BACKEND_WS_URL=wss://${HOPPSCOTCH_SERVER_HOSTNAME}/graphql
VITE_BACKEND_API_URL=https://${HOPPSCOTCH_SERVER_HOSTNAME}/v1

# Terms Of Service And Privacy Policy Links (Optional)
VITE_APP_TOS_LINK=https://docs.hoppscotch.io/support/terms
VITE_APP_PRIVACY_POLICY_LINK=https://docs.hoppscotch.io/support/privacy

## Required for subpath-based access. Don't change this!
ENABLE_SUBPATH_BASED_ACCESS=true
